# ==============================================================================
# NDI Streamer Configuration
# Copy to .env and edit. Never commit .env to version control.
# ==============================================================================

# --- Database -----------------------------------------------------------------
# SQLite (default):
DATABASE_URL=sqlite:///ndi_streamer.db
# PostgreSQL:
# DATABASE_URL=postgresql://user:pass@localhost:5432/ndi_streamer

# --- Flask --------------------------------------------------------------------
SECRET_KEY=change-me-in-production
# "development" enables the Werkzeug debugger — only honoured when FLASK_HOST
# is loopback (127.0.0.1); never use it on a network-facing box
FLASK_ENV=production
# Bind address: 0.0.0.0 = all interfaces; 127.0.0.1 when behind nginx
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Optional DNS-rebinding guard: every hostname/IP used to reach the box,
# comma-separated. Empty = accept any Host header.
ALLOWED_HOSTS=

# --- NDI Defaults -------------------------------------------------------------
# Stored only — NDI sources always show as "<OS hostname> (Instance Name)";
# rename the computer to change the machine part (see README: NDI source naming)
NDI_HOSTNAME=NDI-STREAMER
NDI_OUTPUT_FPS=60

# --- Browser Recycling --------------------------------------------------------
# Hours between full Chromium restarts per instance (prevents memory leaks)
BROWSER_RECYCLE_HOURS=4

# --- Uploads ------------------------------------------------------------------
UPLOAD_FOLDER=app/uploads
MAX_UPLOAD_SIZE_MB=500
# Reject images above this many megapixels (8K UHD ≈ 33 MP) and cut
# PowerPoint/PDF decks at this many pages
MAX_IMAGE_MEGAPIXELS=100
MAX_DECK_PAGES=300

# --- Video optimization ---------------------------------------------------------
# Background one-time transcode of uploaded videos into the cheapest-to-decode
# playback format (H.264/yuv420p MP4, tune fastdecode, audio stripped, sized to
# the target box). Requires ffmpeg (apt install ffmpeg). Originals are kept.
# Videos already in the perfect format are probed and marked playback-ready
# without re-encoding.
#   all       = check every video, convert whatever isn't ideal (default;
#               also sweeps pre-existing library files at boot)
#   oversized = only convert videos larger than the target box
#   off       = never transcode
VIDEO_OPTIMIZE=all
VIDEO_TARGET_WIDTH=1920
VIDEO_TARGET_HEIGHT=1080
# x264 quality/speed of the one-time encode (not playback cost)
VIDEO_CRF=20
VIDEO_PRESET=veryfast

# --- Signage ------------------------------------------------------------------
# DPI used when rasterizing PowerPoint/PDF decks into slide images
# (needs libreoffice-impress + poppler-utils installed). 150 ≈ 2000x1125 per
# 16:9 slide.
PRESENTATION_RENDER_DPI=150

# RAM budget (MB) for decoded signage stills, per signage worker. Stills that
# already played stay in memory and are never re-read from disk while they fit.
SIGNAGE_STILL_CACHE_MB=256

# --- RAM-backed runtime files ---------------------------------------------------
# Constantly rewritten throwaway files (preview JPEGs ~every 2s per instance,
# signage now-playing status 1/s) default to tmpfs (/dev/shm) on Linux so the
# writes land in RAM instead of wearing the SSD. Override to force a location
# (e.g. a disk path, or leave unset on Windows for the app folder fallback).
# PREVIEW_FOLDER=/dev/shm/webretriever2_previews
# SIGNAGE_RUNTIME_FOLDER=/dev/shm/webretriever2_runtime

# --- Logging / Syslog ---------------------------------------------------------
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable syslog forwarding (true/false)
SYSLOG_ENABLED=false

# Syslog target — local socket or remote host
# Local:  /dev/log  (Linux only)
# Remote: host:port (e.g. 192.168.1.100:514)
# Windows: use a remote address or leave SYSLOG_ENABLED=false
SYSLOG_ADDRESS=/dev/log

# Syslog facility (local0-local7, user, daemon, etc.)
SYSLOG_FACILITY=local0

# Syslog app identifier
SYSLOG_TAG=ndi-streamer
